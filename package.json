{
  "name": "@xqvvu/boilerplate",
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run @xqvvu/web#dev",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "prepare": "vp config",
    "ready": "vp check && vp run -r test && vp run -r build",
    "test": "vp run -r test",
    "typecheck": "vp run -r typecheck"
  },
  "devDependencies": {
    "@astryxdesign/cli": "catalog:astryx",
    "@astryxdesign/core": "catalog:astryx",
    "@astryxdesign/theme-neutral": "catalog:astryx",
    "@stylexjs/eslint-plugin": "catalog:astryx",
    "@stylexjs/stylex": "catalog:astryx",
    "@tanstack/eslint-plugin-query": "catalog:tanstack",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.4.1",
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  }
}
