{
  "name": "@xqvvu/server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc && vp pack",
    "start": "node --enable-source-maps dist/main.mjs",
    "test": "vp test run",
    "test:ui": "vp test run -w --ui",
    "test:coverage": "vp test run --ui -w --coverage",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:test",
    "@vitest/ui": "catalog:test",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
