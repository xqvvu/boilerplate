{
  "name": "@xqvvu/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc && vp pack",
    "start": "node --enable-source-maps dist/main.mjs",
    "test": "vp test run",
    "test:ui": "vp test run -w --ui",
    "test:coverage": "vp test run --ui -w --coverage",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@orpc/openapi": "catalog:orpc",
    "@orpc/server": "catalog:orpc",
    "@orpc/zod": "catalog:orpc",
    "@t3-oss/env-core": "catalog:",
    "@xqvvu/api": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orpc/client": "catalog:orpc",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:test",
    "@vitest/ui": "catalog:test",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
